# ─────────────────────────────────────────────────────────────
#  DSeT Website — Required Environment Variables
#  Copy this file to .env.local and fill in real values
#  On Azure: set ALL of these in App Service → Configuration → Application Settings
# ─────────────────────────────────────────────────────────────

# ── Email ─────────────────────────────────────────────────────
# Gmail/Outlook account used to SEND notification emails
EMAIL_USER=

# Account password (or App Password if 2FA is enabled)
EMAIL_PASS=

# Company inbox — where contact & application notifications are delivered
CONTACT_EMAIL=

# ── Admin Panel ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ── PostgreSQL Database ───────────────────────────────────────
# Used by drizzle-kit push (local dev only)
DATABASE_URL=postgresql://postgres:your_password@your-db-host:5432/dset_db

# Used by the app at runtime (set each individually on Azure)
DB_HOST=your-azure-postgres-host.postgres.database.azure.com
DB_PORT=5432
DB_NAME=dset_db
DB_USER=postgres
DB_PASSWORD=your_password

# ── Azure OpenAI (chat widget + digital assessment) ───────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ── Voice Provider ────────────────────────────────────────────
# browser = free Web Speech API (recommended)
# azure   = Azure Cognitive Services Speech (better quality)
VOICE_PROVIDER=browser
NEXT_PUBLIC_VOICE_PROVIDER=browser

# Required only if VOICE_PROVIDER=azure
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus2

# Required only if VOICE_PROVIDER=azure (client-side realtime voice)
NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT=
NEXT_PUBLIC_AZURE_OPENAI_DEPLOYMENT=
NEXT_PUBLIC_AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ── Azure Blob Storage (file uploads — images, resumes, event media) ─
# Get from: Azure Portal → Storage Account → Access Keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=uploads

# ── TinyMCE (admin blog editor) ───────────────────────────────
# Get free API key from: https://www.tiny.cloud/
NEXT_PUBLIC_TINY_MCE_API_KEY=your_tinymce_api_key_here
