# ─────────────────────────────────────────────────────────────
#  DSeT Website — Required Environment Variables
#  Copy this file to .env.local and fill in real values
#  On Azure: set ALL of these in App Service → Configuration → Application Settings
# ─────────────────────────────────────────────────────────────

# ── Email ─────────────────────────────────────────────────────
# Gmail/Outlook account used to SEND notification emails
EMAIL_USER=

# Account password (or App Password if 2FA is enabled)
EMAIL_PASS=

# Company inbox — where contact & application notifications are delivered
CONTACT_EMAIL=

# ── Admin Panel ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Signing key for the admin session cookie (HMAC-SHA256). Any long random
# string — generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank the key is derived from ADMIN_PASSWORD so existing deployments
# keep working, but setting it explicitly means rotating the admin password does
# not silently invalidate every session (and vice versa).
# Changing this value logs every admin out immediately.
ADMIN_SESSION_SECRET=

# ── Razorpay (DSeT Academy cohort enrolment) ──────────────────
# Dashboard → Settings → API Keys. key_id is public; key_secret is server-only
# and must never be exposed to the browser or committed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks. Create a webhook pointing at
#   https://<your-domain>/api/academy/razorpay-webhook
# subscribed to: payment.captured, payment.failed, order.paid
# The secret you set there goes here — it is what proves a webhook is genuinely
# from Razorpay. Without it, paid enrolments are only confirmed when the user's
# browser completes the callback.
RAZORPAY_WEBHOOK_SECRET=

# Where new paid-enrolment alerts are emailed — falls back to CONTACT_EMAIL
ACADEMY_NOTIFY_EMAIL=

# ── PostgreSQL Database (Neon) ───────────────────────────────────
# Used by drizzle-kit push AND by the app at runtime — this is the only
# DB variable the code reads. Configured with Neon Postgres connection pooling.
DATABASE_URL=postgresql://neondb_owner:<password>@ep-fragrant-wildflower-b3sk3elb-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Server-to-server integration token for /api/academy/refer-to-lifesci
LIFESCI_INTEGRATION_TOKEN=your_integration_token_here

# ── Azure OpenAI (chat widget + digital assessment) ───────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ── Voice Provider ────────────────────────────────────────────
# browser = free Web Speech API (recommended)
# azure   = Azure Cognitive Services Speech (better quality)
VOICE_PROVIDER=browser
NEXT_PUBLIC_VOICE_PROVIDER=browser

# Required only if VOICE_PROVIDER=azure
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus2

# Required only if VOICE_PROVIDER=azure (client-side realtime voice)
NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT=
NEXT_PUBLIC_AZURE_OPENAI_DEPLOYMENT=
NEXT_PUBLIC_AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ── Azure Blob Storage (file uploads — images, resumes, event media) ─
# Get from: Azure Portal → Storage Account → Access Keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=uploads

# ── Google reCAPTCHA v3 (fake lead detection) ─────────────────
# Get from: console.cloud.google.com → reCAPTCHA → Create key (v3)
# Site key goes in the frontend (public); secret key stays server-side only
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ── Google Tag Manager ────────────────────────────────────────
# GTM Container ID from: tagmanager.google.com → your container → top-right
# Format: GTM-XXXXXXX
# GA4 Measurement ID (G-XXXXXXXXXX) is configured INSIDE GTM dashboard — NOT here
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Analytics & Webmaster Verification ───────────────────────
# Google Search Console: search.google.com/search-console → Add property → HTML tag
# Copy only the content="..." value (not the full meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools: bing.com/webmasters → Add site → Meta tag
# Copy only the content="..." value
NEXT_PUBLIC_BING_VERIFICATION=

# Microsoft Clarity: clarity.microsoft.com → New project → copy Project ID only
# Format: alphanumeric string ~10 chars (e.g. abc123defg)
NEXT_PUBLIC_CLARITY_ID=

# ── Site URL (used to build absolute links in emails / LinkedIn posts) ─
NEXT_PUBLIC_BASE_URL=https://dsetconsulting.com
# NOTE: src/pages/api/whitepaper-leads.ts reads NEXT_PUBLIC_SITE_URL (not
# NEXT_PUBLIC_BASE_URL) for its admin-notification email link — this is an
# existing naming inconsistency in the code, not a typo here. Set both to
# the same value until that's unified in code.
NEXT_PUBLIC_SITE_URL=https://dsetconsulting.com

# ── LinkedIn API (auto-post blog to company page) ─────────────
# Get from: LinkedIn Developer Portal → your app → Auth tab
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_COMPANY_ID=

# ── Cron Job Secret (protects /api/cron/publish-scheduled and
#    /api/cron/whatsapp-expire-handover) ───
# Any long random string — must match what the GitHub Actions / scheduler
# sends as the Authorization header
CRON_SECRET=

# ── WhatsApp Cloud API (Coexistence with the WhatsApp Business App) ──
# All values below come from Meta Business Manager / WhatsApp Manager /
# Meta for Developers — see the Meta-side setup checklist before filling
# these in. Test everything against a Meta test phone number first; only
# point this config at the live DSeT number after explicit sign-off.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0

# Destination number for the website's wa.me CTA button — E.164, digits only, no +
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Where human-handover alerts are emailed — falls back to CONTACT_EMAIL if unset
WHATSAPP_HANDOVER_NOTIFY_EMAIL=

# ── WhatsApp Coexistence — Embedded Signup (admin/whatsapp/coexistence-setup) ──
# NEXT_PUBLIC_META_APP_ID = the app's own App ID (Basic Settings page, public info)
# NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID = generated by Meta's
#   "Embedded Signup Builder" (App Dashboard → Become a Partner → Embedded
#   Signup Builder) — configure it for WhatsApp Business App / Coexistence
#   onboarding, then copy the Configuration ID it outputs.
# Test against the TEST number first — never point a live-number pairing
# attempt at this page without explicit sign-off.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# ── Zoho CRM Integration (Phase 1 — foundation only, disabled by default) ─────
# Master kill switch. Must be the literal string "true" to allow any Zoho API call.
# Everything else in src/lib/zoho/* is a no-op while this is not "true".
ZOHO_SYNC_ENABLED=false

# "dry-run" logs the payload that would be sent and makes no network call;
# "live" actually calls the Zoho API. Only meaningful once ZOHO_SYNC_ENABLED=true.
ZOHO_SYNC_MODE=dry-run

# OAuth client — from Zoho API Console (api-console.zoho.com), Server-based Application.
# NOT created yet — leave blank until a real Zoho org/app exists.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://dsetconsulting.com/api/admin/zoho/callback

# Data center the Zoho org was created on — determines both endpoints below.
# accounts.zoho.com / .in / .eu / .com.au / .jp  (accounts) — www.zohoapis.<same tld> (api)
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in
ZOHO_API_DOMAIN=www.zohoapis.in

# Retry cap before a queue row is marked failed_permanent instead of retried again.
ZOHO_MAX_SYNC_ATTEMPTS=5

# NOTE: there is deliberately no ZOHO_REFRESH_TOKEN env var — per the approved integration
# plan, the refresh token is stored in the zoho_oauth_tokens DB table (written by the OAuth
# callback route), not as an environment variable. The access token is never stored anywhere
# except an in-memory cache in src/lib/zoho/auth.ts.

# ── Google Sheets Sync (Career Applications) ───────────────────
# Every job application submitted on /careers is appended as a new row in a
# company Google Sheet, in addition to the existing DB save + email alert.
# See src/lib/googleSheets.server.ts.
#
# One-time setup (Google Cloud Console, ~15 min, no coding):
#   1. console.cloud.google.com → log in with the COMPANY Google account
#   2. Create a project (e.g. "DSeT Careers Sheet") — free, no billing needed
#   3. APIs & Services → Enable APIs → enable "Google Sheets API"
#   4. APIs & Services → Credentials → Create Credentials → Service Account
#   5. Open the service account → Keys tab → Add Key → Create new key → JSON
#      → downloads a .json file. Never commit this file or paste it into git.
#   6. sheets.new → create a sheet, e.g. "DSeT Job Applications"
#      (headers are auto-created by the code on first write if the sheet is empty)
#   7. Share that Sheet → paste the JSON's "client_email" value → give it Editor access
#   8. Copy the Sheet ID from its URL: the long string between /d/ and /edit
#
# Kill switch — must be the literal string "true" to enable any Sheets write.
# Leaves the integration a silent no-op until setup above is complete.
GOOGLE_SHEETS_SYNC_ENABLED=false

# From the downloaded JSON key: "client_email" field
GOOGLE_SHEETS_CLIENT_EMAIL=

# From the downloaded JSON key: "private_key" field — paste it AS-IS, including
# the literal \n sequences and the -----BEGIN/END PRIVATE KEY----- lines; the
# code converts \n to real newlines at runtime.
GOOGLE_SHEETS_PRIVATE_KEY=

# The Sheet ID from the Google Sheet's URL (between /d/ and /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Tab/sheet name to write into — defaults to "Sheet1" if left blank
GOOGLE_SHEETS_TAB_NAME=Sheet1

# ─── DSeT Academy — Google sign-in (brochure access) ───
# OAuth Web client ID. Add every site origin under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Long random string; signs the dset_academy_user cookie (`openssl rand -hex 48`).
ACADEMY_AUTH_SECRET=
# Server-side only; the download popup's sign-in code is exchanged with it.
GOOGLE_CLIENT_SECRET=
